{
  // Type-checks the browser modules (JSDoc, checkJs) with the DOM's types and no Bun types: bunx tsc --noEmit -p public
  // Written with Claude Code (AI) for Vicky.
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["*.js"]
}
