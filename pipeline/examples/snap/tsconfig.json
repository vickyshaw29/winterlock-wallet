{
  // The Snap's own typecheck (npm test runs it): a Snap has no DOM and no Node, only the language and the Snaps SDK.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "snap.config.ts"]
}
